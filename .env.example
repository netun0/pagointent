# Testnet or devnet sponsor key. Created by `npm run chain:setup`.
# This key only pays gas and mints demo USDC. Do not commit it.
# Without it, the app uses the local preview ledger instead of Sui.
SPONSOR_SECRET_KEY=

# Optional. JSON map of demo desk ids to Sui secret keys, so Contact can sign
# on a host that does not have data/merchant-secrets.json. Do not commit it.
# MERCHANT_SECRETS_JSON={"harbor":"...","kanda":"...","night":"..."}

# Optional. Defaults to testnet. Use devnet if the testnet faucet is rate limited.
# SUI_NETWORK=devnet

# Google OAuth client id for agent zkLogin (Web application).
# Register redirect URI: https://YOUR_HOST/auth/zklogin/callback
# and for local dev: http://127.0.0.1:43123/auth/zklogin/callback
# NEXT_PUBLIC_GOOGLE_ZKLOGIN_CLIENT_ID=

# Optional overrides for Mysten hosted zkLogin services (devnet/testnet defaults work).
# ZKLOGIN_PROVER_URL=
# ZKLOGIN_SALT_URL=
