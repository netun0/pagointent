# Testnet or devnet sponsor key. Created by `npm run chain:setup`.
# This key only pays gas and mints demo USDC. Do not commit it.
# Without it, the app uses the local preview ledger instead of Sui.
SPONSOR_SECRET_KEY=

# Optional. Defaults to testnet. Use devnet if the testnet faucet is rate limited.
# SUI_NETWORK=devnet
